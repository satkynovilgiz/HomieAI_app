{
  "expo": {
    "name": "HOMIE AI",
    "slug": "homieapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homieai",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homieai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "HOMIE needs camera to scan your homework",
        "NSMicrophoneUsageDescription": "HOMIE needs your mic to hear you in Voice Mode.",
        "NSPhotoLibraryUsageDescription": "HOMIE needs photos to scan homework",
        "NSSpeechRecognitionUsageDescription": "HOMIE needs speech recognition to understand you in Voice Mode.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07070f"
      },
      "package": "com.homieai.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-av",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7c3aed"
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "HOMIE needs your mic to hear you in Voice Mode.",
          "speechRecognitionPermission": "HOMIE needs speech recognition to understand you in Voice Mode.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64db5adb-e6b6-4604-b7a7-e33c56fcc3b0"
      }
    },
    "owner": "ilgizsatkynov",
    "updates": {
      "url": "https://u.expo.dev/64db5adb-e6b6-4604-b7a7-e33c56fcc3b0"
    }
  }
}
